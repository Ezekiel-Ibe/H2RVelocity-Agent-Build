# Backend-for-frontend (BFF) configuration.
# Copy to `.env` and fill in. Never commit `.env`. Secrets stay here, never in
# the frontend.

# Data source: "sample" runs with built-in demo data (no Fabric needed);
# "fabric" queries the Microsoft Fabric SQL endpoint (read-only).
DATA_SOURCE=sample

# Fabric SQL analytics endpoint (the ...datawarehouse.fabric.microsoft.com host)
# and database (warehouse/lakehouse SQL endpoint) name.
FABRIC_SQL_ENDPOINT=
FABRIC_DATABASE=edm_wh_dev

# Comma-separated allowed browser origins (the frontend dev/preview URLs).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Locally, set true so DefaultAzureCredential uses the Azure CLI (az login).
# In Azure, leave false so the managed identity is used.
AZURE_EXCLUDE_MANAGED_IDENTITY=true

# --- Foundry prompt agent (powers the agent-chat panel) ---
# When set, /api/agent/messages calls the deployed Foundry prompt agent.
FOUNDRY_PROJECT_ENDPOINT=https://velocity-h2r-proj-resource.services.ai.azure.com/api/projects/velocity-h2r-proj
FOUNDRY_AGENT_NAME=a01-workspace
FOUNDRY_API_VERSION=2025-05-15-preview
FOUNDRY_SCOPE=https://ai.azure.com/.default
